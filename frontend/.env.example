# =====================================================================
# Delícia Doces — variáveis de ambiente do frontend
# Copie para `.env` caso precise apontar para outra API.
#
# No Vite, só variáveis com o prefixo VITE_ chegam ao código do navegador.
# NUNCA coloque segredos aqui: tudo isso vai para o bundle público.
# =====================================================================

# Deixe vazio para usar o proxy do Vite (recomendado em desenvolvimento).
# Em produção, aponte para a URL pública da API. Ex.: https://api.exemplo.com/api
VITE_API_URL=
