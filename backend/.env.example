# =====================================================================
# Delícia Doces — variáveis de ambiente do backend
# Copie este arquivo para `.env` e ajuste os valores locais.
#   cp .env.example .env
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).
# =====================================================================

# --- Servidor ---
PORT=3333
NODE_ENV=development

# --- Banco de dados (PostgreSQL) ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deliciadoces?schema=public"

# Conexão DIRETA, usada só pelas migrations.
# Localmente é a mesma coisa, então pode deixar em branco (o código usa a
# DATABASE_URL como reserva). Em produção as duas são DIFERENTES: a de cima
# passa pelo pooler (porta 6543) e esta é direta (5432). Ver docs/DEPLOY.md.
# (o nome DIRECT_URL, usado no modelo do Supabase, também é aceito)
DIRECT_DATABASE_URL=

# --- Autenticação (JWT) ---
# Em produção, gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"  # <- vale para dev; produção usa segredo forte
JWT_EXPIRES_IN="1d"

# --- CORS ---
# Origem do frontend autorizada a consumir a API (separe múltiplas por vírgula)
CORS_ORIGIN="http://localhost:5173"
