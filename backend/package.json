{
  "name": "@deliciadoces/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do sistema de gestão da Delícia Doces (Node.js + Express + Prisma).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "node prisma/seed-demo.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
