// ---------------------------------------------------------------
// app.deliciadoces — schema inicial
// Decisões baseadas nas respostas da Dalila (Forms, 14/09):
//  - não vende fiado, recebe tudo na entrega  -> sem contas a receber
//  - produz em lote antes de vender           -> venda baixa produto pronto
//  - controla insumo E produto pronto         -> estoque em dois níveis
//  - ficha técnica "só se for simples"        -> opcional, não bloqueia nada
//  - quer aviso de item acabando e validade   -> estoqueMinimo + validade por entrada
//  - dinheiro pessoal e do negócio é tudo junto -> categoria RETIRADA_PESSOAL
//
// Difere do rascunho original em dois pontos, ambos acordados:
//  - `url` saiu do datasource (exigência do Prisma 7, ver comentário abaixo)
//  - @@unique([nome]) em Insumo e Produto, para impedir cadastro duplicado
//    ("Chocolate" duas vezes racharia o saldo em dois)
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A URL de conexão NÃO fica mais aqui: no Prisma 7 ela vive em
  // `prisma.config.js` (usado pela CLI nas migrations) e no driver
  // adapter passado ao PrismaClient em `src/lib/prisma.js`.
  // Este arquivo descreve só o MODELO.
}

// ---------------------------------------------------------------
// Usuário
// ---------------------------------------------------------------

enum PapelUsuario {
  ADMIN      // Dalila — acesso total
  OPERADOR   // reservado: lança venda e estoque, não vê resultado financeiro
}

model Usuario {
  id        String       @id @default(uuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(ADMIN)
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())
  editadoEm DateTime     @updatedAt

  vendas         Venda[]
  despesas       Despesa[]
  producoes      Producao[]
  movimentacoes  MovimentacaoEstoque[]
  fechamentos    FechamentoDiario[]

  @@map("usuarios")
}

// ---------------------------------------------------------------
// Enums gerais
// ---------------------------------------------------------------

enum UnidadeMedida {
  G
  KG
  ML
  L
  UNIDADE
  PACOTE
  LATA
  CAIXA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
}

enum TipoCategoria {
  CUSTO_OPERACIONAL  // entra no cálculo de lucro do negócio
  RETIRADA_PESSOAL   // sai do caixa mas não é custo — não polui o lucro
}

enum TipoMovimentacao {
  ENTRADA_COMPRA     // chegou mercadoria
  ENTRADA_PRODUCAO   // lote produzido virou produto pronto
  SAIDA_PRODUCAO     // insumo consumido para produzir
  SAIDA_VENDA        // produto pronto vendido
  PERDA              // estragou, venceu, queimou
  AJUSTE             // contagem manual corrigiu o saldo
}

// ---------------------------------------------------------------
// Insumos (ingredientes, embalagem)
// ---------------------------------------------------------------

model Insumo {
  id              String        @id @default(uuid())
  nome            String
  unidade         UnidadeMedida
  quantidadeAtual Decimal       @default(0) @db.Decimal(12, 3)
  estoqueMinimo   Decimal       @default(0) @db.Decimal(12, 3)
  custoUnitario   Decimal       @default(0) @db.Decimal(12, 4) // custo médio, atualizado a cada compra
  controlaValidade Boolean      @default(false)
  fornecedorPadrao String?
  ativo           Boolean       @default(true)
  criadoEm        DateTime      @default(now())
  editadoEm       DateTime      @updatedAt

  movimentacoes    MovimentacaoEstoque[]
  fichasTecnicas   FichaTecnicaItem[]

  @@unique([nome])
  @@index([ativo])
  @@map("insumos")
}

// ---------------------------------------------------------------
// Produtos prontos (os doces)
// ---------------------------------------------------------------

model Produto {
  id              String        @id @default(uuid())
  nome            String
  precoVenda      Decimal       @db.Decimal(10, 2)
  unidade         UnidadeMedida @default(UNIDADE)
  quantidadeAtual Decimal       @default(0) @db.Decimal(12, 3)
  estoqueMinimo   Decimal       @default(0) @db.Decimal(12, 3)
  // Quantos o lote rende quando a ficha técnica é executada uma vez.
  // Null = produto sem ficha técnica cadastrada (perfeitamente válido).
  rendimentoReceita Int?
  ativo           Boolean       @default(true)
  criadoEm        DateTime      @default(now())
  editadoEm       DateTime      @updatedAt

  fichaTecnica   FichaTecnicaItem[]
  itensVenda     ItemVenda[]
  producoes      Producao[]
  movimentacoes  MovimentacaoEstoque[]

  @@unique([nome])
  @@index([ativo])
  @@map("produtos")
}

// Ficha técnica: quanto de cada insumo o produto consome por lote.
// Opcional — se estiver vazia, a produção é lançada informando os insumos na mão.
model FichaTecnicaItem {
  id         String  @id @default(uuid())
  produtoId  String
  insumoId   String
  quantidade Decimal @db.Decimal(12, 3)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([produtoId, insumoId])
  @@map("ficha_tecnica_itens")
}

// ---------------------------------------------------------------
// Produção (lote)
// ---------------------------------------------------------------

model Producao {
  id             String   @id @default(uuid())
  data           DateTime @default(now())
  produtoId      String
  quantidade     Decimal  @db.Decimal(12, 3) // quanto de produto pronto gerou
  custoEstimado  Decimal? @db.Decimal(10, 2) // soma dos insumos consumidos
  observacao     String?
  usuarioId      String?
  criadoEm       DateTime @default(now())
  editadoEm      DateTime @updatedAt

  produto       Produto               @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  usuario       Usuario?              @relation(fields: [usuarioId], references: [id])
  movimentacoes MovimentacaoEstoque[]

  @@index([data])
  @@map("producoes")
}

// ---------------------------------------------------------------
// Vendas — sempre à vista (sem fiado, sem parcela, sem sinal)
// ---------------------------------------------------------------

model Venda {
  id             String         @id @default(uuid())
  data           DateTime       @default(now())
  subtotal       Decimal        @db.Decimal(10, 2)
  desconto       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  formaPagamento FormaPagamento
  clienteNome    String?        // opcional: ela não costuma anotar
  observacao     String?
  cancelada      Boolean        @default(false)
  usuarioId      String?
  criadoEm       DateTime       @default(now())
  editadoEm      DateTime       @updatedAt

  itens         ItemVenda[]
  usuario       Usuario?              @relation(fields: [usuarioId], references: [id])
  movimentacoes MovimentacaoEstoque[]

  @@index([data])
  @@index([cancelada])
  @@map("vendas")
}

model ItemVenda {
  id            String  @id @default(uuid())
  vendaId       String
  produtoId     String
  quantidade    Decimal @db.Decimal(12, 3)
  precoUnitario Decimal @db.Decimal(10, 2) // congelado no momento da venda
  subtotal      Decimal @db.Decimal(10, 2)

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@map("itens_venda")
}

// ---------------------------------------------------------------
// Despesas
// ---------------------------------------------------------------

model CategoriaDespesa {
  id       String        @id @default(uuid())
  nome     String        @unique
  tipo     TipoCategoria @default(CUSTO_OPERACIONAL)
  ativo    Boolean       @default(true)
  criadoEm DateTime      @default(now())

  despesas Despesa[]

  @@map("categorias_despesa")
}

model Despesa {
  id             String          @id @default(uuid())
  data           DateTime        @default(now())
  descricao      String
  valor          Decimal         @db.Decimal(10, 2)
  categoriaId    String
  formaPagamento FormaPagamento?
  recorrente     Boolean         @default(false) // aluguel, internet, luz
  fornecedor     String?
  usuarioId      String?
  criadoEm       DateTime        @default(now())
  editadoEm      DateTime        @updatedAt

  categoria     CategoriaDespesa      @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  usuario       Usuario?              @relation(fields: [usuarioId], references: [id])
  // Quando a despesa é compra de ingrediente, as entradas de estoque nascem junto
  movimentacoes MovimentacaoEstoque[]

  @@index([data])
  @@map("despesas")
}

// ---------------------------------------------------------------
// Movimentação de estoque — razão de tudo que entra e sai
// ---------------------------------------------------------------

model MovimentacaoEstoque {
  id            String           @id @default(uuid())
  data          DateTime         @default(now())
  tipo          TipoMovimentacao
  // Exatamente um dos dois é preenchido (validado na aplicação)
  insumoId      String?
  produtoId     String?
  quantidade    Decimal          @db.Decimal(12, 3) // sempre positiva; o tipo diz a direção
  custoUnitario Decimal?         @db.Decimal(12, 4)
  validade      DateTime?        // preenchida nas entradas de compra
  motivo        String?          // obrigatório na aplicação quando tipo = PERDA ou AJUSTE

  // Rastreabilidade: de onde essa movimentação nasceu
  vendaId    String?
  producaoId String?
  despesaId  String?
  usuarioId  String?

  criadoEm DateTime @default(now())

  insumo   Insumo?   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  produto  Produto?  @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  venda    Venda?    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  producao Producao? @relation(fields: [producaoId], references: [id], onDelete: Cascade)
  despesa  Despesa?  @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  usuario  Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([data])
  @@index([insumoId])
  @@index([produtoId])
  @@index([tipo])
  @@map("movimentacoes_estoque")
}

// ---------------------------------------------------------------
// Fechamento diário de caixa — ela confere todo dia
// ---------------------------------------------------------------

model FechamentoDiario {
  id             String   @id @default(uuid())
  data           DateTime @unique @db.Date
  saldoInicial   Decimal  @default(0) @db.Decimal(10, 2)
  totalEntradas  Decimal  @default(0) @db.Decimal(10, 2)
  totalSaidas    Decimal  @default(0) @db.Decimal(10, 2)
  saldoCalculado Decimal  @default(0) @db.Decimal(10, 2)
  saldoConferido Decimal? @db.Decimal(10, 2) // o que ela contou de verdade
  diferenca      Decimal? @db.Decimal(10, 2) // conferido - calculado
  observacao     String?
  usuarioId      String?
  criadoEm       DateTime @default(now())
  editadoEm      DateTime @updatedAt

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("fechamentos_diarios")
}
